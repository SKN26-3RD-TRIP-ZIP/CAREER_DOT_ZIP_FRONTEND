# 프론트엔드 환경변수 (Vite). 실제 값은 .env.local 에만, 커밋 금지.
# 백엔드 API base URL.
# 주의: 프론트(localhost:5173)와 API host 를 'localhost' 로 통일한다.
# localhost 와 127.0.0.1 을 섞으면 cross-site 로 간주되어 refresh_token(SameSite=Lax)
# 쿠키가 저장/전송되지 않아 토큰 자동 재발급이 실패한다.
VITE_API_BASE_URL=/api/v1

# 소셜 로그인 버튼 노출 토글. 'false' 면 버튼을 '준비 중'으로 비활성화한다.
# 실제 Client ID/Secret 은 백엔드(.env)에만 둔다. Client Secret 을 프론트 환경변수에
# 절대 넣지 않는다. (프론트는 시작 요청만 보내고 인가 URL 은 백엔드가 생성)
VITE_GOOGLE_OAUTH_ENABLED=true
VITE_KAKAO_OAUTH_ENABLED=true

# 개발용: 리포트 등에서 네트워크 없이 목업 응답 사용. 운영/기본은 false.
VITE_USE_MOCK=false
